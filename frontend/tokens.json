{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "HackBet — Ledger",
  "description": "Black + orange sportsbook DNA. Single accent, flat fills, block-caps display type.",
  "color": {
    "ink":         { "value": "#0A0A0A" },
    "ink-deep":    { "value": "#000000" },
    "bone":        { "value": "#F4F1EA" },
    "bone-dim":    { "value": "#E9E3D4" },
    "orange":      { "value": "#FF5B14" },
    "orange-deep": { "value": "#E0440A" },
    "orange-glow": { "value": "#FF7A3D" },

    "status": {
      "success": { "light": "#0E8F5C", "dark": "#34C77F" },
      "warning": { "light": "#D97706", "dark": "#FBBF24" },
      "danger":  { "light": "#C72A1F", "dark": "#F26E5F" },
      "info":    { "light": "#3A4FE3", "dark": "#7C8AF0" }
    },

    "surface": {
      "page-bg":     { "light": "#F4F1EA", "dark": "#0A0A0A" },
      "card-bg":     { "light": "#FFFFFF", "dark": "rgba(255,255,255,0.03)" },
      "card-bg-alt": { "light": "#E9E3D4", "dark": "rgba(255,255,255,0.05)" },
      "card-border": { "light": "rgba(10,10,10,0.10)", "dark": "rgba(255,255,255,0.08)" },
      "modal-bg":    { "light": "#FFFFFF", "dark": "#141414" },
      "nav-bg":      { "light": "rgba(244,241,234,0.8)", "dark": "rgba(10,10,10,0.85)" },
      "nav-border":  { "light": "rgba(10,10,10,0.10)", "dark": "rgba(255,91,20,0.15)" }
    },

    "text": {
      "1": { "light": "#0A0A0A", "dark": "#F4F1EA" },
      "2": { "light": "#2A2A2A", "dark": "#CFCBC0" },
      "3": { "light": "#5A5A55", "dark": "#8A8A82" },
      "4": { "light": "#8A8A82", "dark": "#5A5A55" },
      "5": { "light": "#BFBFB5", "dark": "#3A3A37" }
    },

    "accent": {
      "default": { "light": "#FF5B14", "dark": "#FF5B14" },
      "hover":   { "light": "#E0440A", "dark": "#FF7A3D" },
      "light":   { "light": "#FFE9DC", "dark": "rgba(255,91,20,0.10)" },
      "border":  { "light": "#FFC8A8", "dark": "rgba(255,91,20,0.25)" },
      "text":    { "light": "#E0440A", "dark": "#FF7A3D" }
    },

    "rank": {
      "1":     { "light": { "bg": "#FF5B14", "text": "#0A0A0A" }, "dark": { "bg": "#FF5B14", "text": "#0A0A0A" } },
      "2":     { "light": { "bg": "#E9E3D4", "text": "#0A0A0A" }, "dark": { "bg": "rgba(255,255,255,0.06)", "text": "#F4F1EA" } },
      "3":     { "light": { "bg": "rgba(255,91,20,0.15)", "text": "#E0440A" }, "dark": { "bg": "rgba(255,91,20,0.15)", "text": "#FF7A3D" } },
      "other": { "light": { "bg": "rgba(10,10,10,0.04)", "text": "#0A0A0A" }, "dark": { "bg": "rgba(255,255,255,0.04)", "text": "#F4F1EA" } },
      "none":  { "light": { "bg": "rgba(10,10,10,0.03)", "text": "#8A8A82" }, "dark": { "bg": "rgba(255,255,255,0.03)", "text": "#5A5A55" } }
    }
  },

  "font": {
    "display": { "family": "Archivo Black", "weight": 900, "letterSpacing": "-0.055em", "case": "uppercase" },
    "ui":      { "family": "Inter",         "weights": [400, 500, 600, 700] },
    "mono":    { "family": "JetBrains Mono", "weights": [400, 600, 700] }
  },

  "radius":  { "sm": 6,  "md": 8,  "lg": 14, "pill": 9999 },
  "shadow":  {
    "card":   "0 1px 3px rgba(10,10,10,0.06)",
    "stamp":  "4px 4px 0 0 #0A0A0A",
    "stamp-orange": "4px 4px 0 0 #FF5B14",
    "none":   "none"
  },
  "border":  { "thin": "1px solid", "thick": "2px solid" },

  "rules": [
    "Orange is the only brand accent. Status colors are functional, not brand.",
    "No gradients on brand surfaces. Flat fills only.",
    "Display headings always uppercase, Archivo Black, letter-spacing -0.055em.",
    "Use mono for addresses, percentages, USDC amounts, status pills, timers.",
    "Differentiate stakers vs. devs with shape (filled vs. outlined), not color."
  ]
}
